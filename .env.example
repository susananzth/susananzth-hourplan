# Copia este archivo a .env y cambia los valores.

# development | testing | production
HOURPLAN_ENV=development

# Obligatoria en producción. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# URL de SQLAlchemy (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://hourplan:hourplan@localhost:55432/hourplan

# Credenciales del contenedor de PostgreSQL (docker compose)
POSTGRES_USER=hourplan
POSTGRES_PASSWORD=hourplan
POSTGRES_DB=hourplan
# Puerto de PostgreSQL publicado en 127.0.0.1 (para clientes del host)
DB_HOST_PORT=55432

# Almacenamiento del límite de intentos (memory:// para un solo proceso)
RATELIMIT_STORAGE_URI=memory://

# Carpeta opcional de configuración de la organización (solo lectura)
# HOURPLAN_OVERLAY_DIR=/overlay

# Conexión MCP para clientes de IA (opcional): cada persona crea su token en Bitácora > Conexión.
# MCP_ENABLED=1

# Dictado por voz (opcional; ver docs del overlay). Sin VOICE_STT_URL no aparece el botón.
# Perfiles de Compose: `make voice-models M=small` y luego `make voice-up`.
# VOICE_STT_URL=http://whisper:8080
# VOICE_STT_MODEL=whisper-small
# VOICE_STT_FILE=ggml-small.bin
# LLM local opcional (perfil voice-llm): archivo GGUF en el volumen de modelos.
# VOICE_LLM_URL=http://llm:8080
# VOICE_LLM_FILE=llm.gguf
# VOICE_MAX_SECONDS=180
